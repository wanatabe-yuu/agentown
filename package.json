{
  "name": "agentown",
  "private": true,
  "version": "0.5.1",
  "license": "MIT",
  "description": "An office of AI agents with real hierarchy, isolated runtimes and enforced permissions, shown as a 2D web office.",
  "repository": {
    "type": "git",
    "url": "https://github.com/wanatabe-yuu/Agentown.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:server": "pnpm --filter @agentown/server dev",
    "dev:web": "pnpm --filter @agentown/web dev",
    "build:web": "pnpm --filter @agentown/web build",
    "build:harness": "pnpm --filter @agentown/harness build",
    "check": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
